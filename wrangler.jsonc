{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "couple-quest",
  // 自定义入口：复用 OpenNext 的 fetch，另挂 scheduled 跑定时提醒
  "main": "custom-worker.ts",
  "compatibility_date": "2025-06-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // workers.dev 地址留着当备用入口
  "workers_dev": true,
  // 正式入口。custom_domain 会让 Cloudflare 自动建 DNS 记录并签证书，
  // 前提是该域名的 zone 已在本账号下激活
  "routes": [{ "pattern": "lovesmia.com", "custom_domain": true }],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // 每小时整点跑一次提醒；具体发不发由 reminder_log 去重决定
  "triggers": {
    "crons": ["0 * * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "couple-quest",
      // 本地开发用占位 id 即可；首次部署前运行
      // `wrangler d1 create couple-quest` 并把返回的 id 填到这里
      "database_id": "9a4ff66a-5786-413c-b2f7-af24fdcc5703",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PHOTOS",
      // 部署前 `wrangler r2 bucket create couple-quest-photos`
      "bucket_name": "couple-quest-photos"
    }
  ],
  "vars": {
    // Passkey 绑定的域名（rpID）。部署后改成真实域名，例如
    // couple-quest.<你的子域>.workers.dev；一旦有人注册了 Passkey 就别再改
    "RP_ID": "lovesmia.com",
    "RP_ORIGIN": "https://lovesmia.com",
    "RP_NAME": "Couple Quest",
    // Web Push 的 VAPID 公钥，本来就要发给浏览器，不是秘密。
    // 私钥是 secret：wrangler secret put VAPID_PRIVATE_KEY
    "VAPID_PUBLIC_KEY": "BKmlRjdp5n3ttS3pUe5fh0NAh8FQLaVNCNpIE9ds9uIJKCH-nlrstXzgZOrZTg5dtMrK4BZxNObik_m9SS-NLU4"
  }
  // SESSION_SECRET / BOOTSTRAP_SECRET 不放这里：
  //   本地开发写在 .dev.vars
  //   生产环境 `wrangler secret put <名字>`
}
