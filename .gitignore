# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
.dev.vars

# cloudflare
/.open-next/
/.wrangler/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# 用户自备的品牌素材：部署时从本地上传，不进公开仓库
/public/logo.svg
/public/icon-192.png
/public/icon-512.png
/public/apple-touch-icon.png
/public/logo-full.svg
/public/kitty-alt.webp
